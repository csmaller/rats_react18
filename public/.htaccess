<IfModule mod_rewrite.c>
    RewriteEngine On

    # The Laravel app lives under the document root. Keep its env and source off the web.
    RewriteRule (^|/)\.env - [F,L]
    RewriteRule \.sqlite$ - [F,L]
    RewriteRule ^backend/(?!public/(index\.php|admin\.css)$) - [F,L]

    # The admin stylesheet lives with Laravel, not the React build.
    RewriteRule ^admin\.css$ backend/public/admin.css [L]

    # Uploaded clips live in /videos, and the Videos page uses that same address.
    RewriteRule ^videos/?$ index.html [L]

    # Laravel handles the API, admin, set-list PDF, and health check.
    RewriteRule ^(api|admin)(/|$) backend/public/index.php [L]
    RewriteRule ^songs\.pdf$ backend/public/index.php [L]
    RewriteRule ^up$ backend/public/index.php [L]

    # Keep files that exist, including the built site and uploads.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React routes such as /videos and /epk.
    RewriteRule ^ index.html [L]
</IfModule>
